# Local paths; never add credentials here. Copy to ignored .env.
HF_HOME=/mnt/d/AI/occam-rl/hf
UV_CACHE_DIR=/mnt/d/AI/occam-rl/uv-cache
OCCAM_RUNS=/mnt/d/AI/occam-rl/runs
OCCAM_DATA=/mnt/d/AI/occam-rl/data
OCCAM_LLAMA_SERVER=/mnt/d/AI/occam-rl/llama.cpp/build/bin/llama-server
# Official binary installation prints this optional, process-scoped library path.
OCCAM_LLAMA_CUDA_LIB=
# If HF_HOME moves the cache, point this to your existing authenticated token file.
HF_TOKEN_PATH=/home/burny/.cache/huggingface/token
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
CUDA_VISIBLE_DEVICES=0
